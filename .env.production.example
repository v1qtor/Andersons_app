# --------------------------------------------------------------------------
# PRODUCTION TEMPLATE — Combell deployment
# --------------------------------------------------------------------------
#
# Copy this to `.env` on the server (never commit the filled-in version).
# Every `__FILL_ME_IN__` needs a real value from Combell's control panel or
# your own accounts (Pusher, Google Cloud). Everything else is either a
# fixed production setting or copied from local dev where it's safe to.
#
# After uploading .env, on the server run (via SSH):
#   php artisan key:generate          (only if APP_KEY below is still blank)
#   php artisan migrate --force
#   php artisan storage:link          (only needed once, first deploy)
#   php artisan optimize
#
# --------------------------------------------------------------------------

APP_NAME=Andersons
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=__FILL_ME_IN__

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Combell's MySQL details — from the "Databases" section of your Combell panel.
DB_CONNECTION=mysql
DB_HOST=__FILL_ME_IN__
DB_PORT=3306
DB_DATABASE=__FILL_ME_IN__
DB_USERNAME=__FILL_ME_IN__
DB_PASSWORD=__FILL_ME_IN__

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies only ever sent over HTTPS — enable once the domain has SSL live.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Same Pusher app as local dev, or a separate prod app if you'd rather
# keep dev/test traffic out of the same Pusher dashboard — your call.
PUSHER_APP_ID=__FILL_ME_IN__
PUSHER_APP_KEY=__FILL_ME_IN__
PUSHER_APP_SECRET=__FILL_ME_IN__
PUSHER_APP_CLUSTER=eu

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_SCHEME=https
VITE_PUSHER_HOST=ws-eu.pusher.com
VITE_PUSHER_PORT=443

# Same Google Maps key as local — but add the production domain to its
# HTTP referrer restrictions in Google Cloud Console before going live,
# otherwise map embeds will silently fail on the live site.
GOOGLE_MAPS_API_KEY=__FILL_ME_IN__

CACHE_STORE=database

# Real SMTP credentials — Combell provides mailboxes/SMTP relay per your
# hosting plan; check their panel for the host/port/username to use.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=__FILL_ME_IN__
MAIL_PORT=587
MAIL_USERNAME=__FILL_ME_IN__
MAIL_PASSWORD=__FILL_ME_IN__
MAIL_FROM_ADDRESS=__FILL_ME_IN__
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
