# --------------------------------------------------------------------------
# WINDOWS SETUP INSTRUCTIONS
# --------------------------------------------------------------------------
#
# 1. Copy this example file to create your local configuration:
#    copy .env.example .env
#
# 2. Create the SQLite database file:
#    type nul > database\database.sqlite
#
# 3. Install dependencies:
#    composer install
#    npm install
#
# 4. Generate your unique application encryption key:
#    php artisan key:generate
#
# 5. Run database migrations and populate with seed data:
#    php artisan migrate --seed
#
# --------------------------------------------------------------------------
# MAC / LINUX SETUP INSTRUCTIONS
# --------------------------------------------------------------------------
#
# 1. Copy this example file to create your local configuration:
#    cp .env.example .env
#
# 2. Create the SQLite database file:
#    touch database/database.sqlite
#
# 3. Install dependencies:
#    composer install
#    npm install
#
# 4. Generate your unique application encryption key:
#    php artisan key:generate
#
# 5. Run database migrations and populate with seed data:
#    php artisan migrate --seed
#
# --------------------------------------------------------------------------
# DARK MODE
# --------------------------------------------------------------------------
#
# Dark mode is currently disabled application-wide (hardcoded to light mode).
# To re-enable dark mode, make the following two code changes:
#
# 1. resources/css/app.css
#    Change:  @custom-variant dark (&:where(.dark-disabled));
#    Back to: @custom-variant dark (&:where(.dark, .dark *));
#
# 2. resources/views/partials/head.blade.php
#    Replace the inline <script> block (classList.remove + localStorage)
#    back with the single Blade directive: @fluxAppearance
#
# --------------------------------------------------------------------------

APP_NAME=Andersons
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

PUSHER_APP_ID=your-pusher-app-id
PUSHER_APP_KEY=your-pusher-app-key
PUSHER_APP_SECRET=your-pusher-app-secret
PUSHER_APP_CLUSTER=eu

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_SCHEME=https
VITE_PUSHER_HOST=ws-eu.pusher.com
VITE_PUSHER_PORT=443

# Used to preview checkpoint addresses and trip routes on an embedded Google Map.
# Create a Google Cloud project, enable "Maps Embed API", attach a billing account
# (Embed API usage itself is never charged), generate a key, and restrict it to
# your domain(s). Leave blank to show a graceful "map unavailable" placeholder.
GOOGLE_MAPS_API_KEY=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
